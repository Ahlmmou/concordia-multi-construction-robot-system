<?xml version="1.0" ?>
<robot name="turtlebot3_burger">
  <!-- <xacro:include filename="$(find turtlebot3_description)/urdf/common_properties.urdf"/> -->

  <!-- Init colour -->
  <material name="black">
      <color rgba="0.0 0.0 0.0 1.0"/>
  </material>

  <material name="dark">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>

  <material name="light_black">
    <color rgba="0.4 0.4 0.4 1.0"/>
  </material>

  <material name="blue">
    <color rgba="0.0 0.0 0.8 1.0"/>
  </material>

  <material name="green">
    <color rgba="0.0 0.8 0.0 1.0"/>
  </material>

  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <material name="orange">
    <color rgba="1.0 0.4235 0.0392 1.0"/>
  </material>

  <material name="brown">
    <color rgba="0.8706 0.8118 0.7647 1.0"/>
  </material>

  <material name="red">
    <color rgba="0.8 0.0 0.0 1.0"/>
  </material>

  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 0.02" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="-0.064 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turtlebot3_gazebo/models/turtlebot3_common/meshes/burger_base.dae" scale="0.0039 0.0028 0.001"/>
      </geometry>
      <material name="light_black"/>
    </visual>

    <collision>
      <origin xyz="-0.064 0.0 0.07" rpy="0 0 0"/>
      <geometry>
        <box size="0.55 0.39 0.16"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <mass value="6.60588032"/>
      <inertia ixx="0.0707981312" ixy="-0.000393411232" ixz="0.00111804112" iyy="0.0678198464" iyz="-0.0001603868928" izz="0.0642056672" />
    </inertial>
  </link>

  <joint name="wheel_left_joint_1" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left_link_1"/>
    <origin xyz="0.1 0.23 0.07" rpy="-1.57 0 0"/>
    <axis xyz="0.0 0.0 2.0"/>
  </joint>

  <link name="wheel_left_link_1">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="1.57 0 0"/>
      <geometry>
        <mesh filename="package://turtlebot3_gazebo/models/turtlebot3_common/meshes/tire.dae" scale="0.003 0.003 0.003"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.05" radius="0.1"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.0 0.0 0.0" />
      <mass value="0.22799152" />
      <inertia ixx="0.00035761856" ixy="-1.355833056e-09" ixz="-1.900215008e-07" iyy="0.000358157216" iyz="-4.60803424e-10" izz="0.000662801856" />
    </inertial>
  </link>

  <joint name="wheel_left_joint_2" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left_link_2"/>
    <origin xyz="-0.2 0.23 0.07" rpy="-1.57 0 0"/>
    <axis xyz="0.0 0.0 2.0"/>
  </joint>

  <link name="wheel_left_link_2">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="1.57 0 0"/>
      <geometry>
        <mesh filename="package://turtlebot3_gazebo/models/turtlebot3_common/meshes/tire.dae" scale="0.003 0.003 0.003"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.05" radius="0.1"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.0 0.0 0.0" />
      <mass value="0.22799152" />
      <inertia ixx="0.00035761856" ixy="-1.355833056e-09" ixz="-1.900215008e-07" iyy="0.000358157216" iyz="-4.60803424e-10" izz="0.000662801856" />
    </inertial>
  </link>

  <joint name="wheel_right_joint_1" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right_link_1"/>
    <origin xyz="0.1 -0.23 0.07" rpy="-1.57 0 0"/>
    <axis xyz="0.0 0.0 2.0"/>
  </joint>

  <link name="wheel_right_link_1">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="1.57 0 0"/>
      <geometry>
        <mesh filename="package://turtlebot3_gazebo/models/turtlebot3_common/meshes/tire.dae" scale="0.003 0.003 0.003"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.036" radius="0.066"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.0 0.0 0.0" />
      <mass value="0.22799152" />
      <inertia ixx="0.00035761856" ixy="-1.355833056e-09" ixz="-1.900215008e-07" iyy="0.000358157216" iyz="-4.60803424e-10" izz="0.000662801856" />
    </inertial>
  </link>

  <joint name="wheel_right_joint_2" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right_link_2"/>
    <origin xyz="-0.2 -0.23 0.07" rpy="-1.57 0 0"/>
    <axis xyz="0.0 0.0 2.0"/>
  </joint>

  <link name="wheel_right_link_2">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="1.57 0 0"/>
      <geometry>
        <mesh filename="package://turtlebot3_gazebo/models/turtlebot3_common/meshes/tire.dae" scale="0.003 0.003 0.003"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.036" radius="0.066"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.0 0.0 0.0" />
      <mass value="0.22799152" />
      <inertia ixx="0.00035761856" ixy="-1.355833056e-09" ixz="-1.900215008e-07" iyy="0.000358157216" iyz="-4.60803424e-10" izz="0.000662801856" />
    </inertial>
  </link>

  <joint name="caster_back_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_back_link"/>
    <origin xyz="-0.162 0.0 -0.008" rpy="-1.57 0 0"/>
  </joint>

  <link name="caster_back_link">
    <collision>
      <origin xyz="0.0 0.002 0.0" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.018 0.04"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.0 0.0 0.0" />
      <mass value="0.04" />
      <inertia ixx="0.032" ixy="0.0" ixz="0.0" iyy="0.032" iyz="0.0" izz="0.032" />
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="-0.064 0.0 0.136" rpy="0 0 0"/>
  </joint>

  <link name="imu_link"/>

  <joint name="scan_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_scan"/>
    <origin xyz="-0.064 0.0 0.344" rpy="0 0 0"/>
  </joint>

  <link name="base_scan">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turtlebot3_gazebo/models/turtlebot3_common/meshes/lds.dae" scale="0.002 0.002 0.002"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <origin xyz="0.03 0.0 -0.013" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.063" radius="0.11"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.912" />
      <origin xyz="0.0 0.0 0.0" />
      <inertia ixx="0.032" ixy="0.0" ixz="0.0" iyy="0.032" iyz="0.0" izz="0.032" />
    </inertial>
  </link>

</robot>
